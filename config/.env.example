# =====================================================================
# CONFIGURACION DEL SISTEMA DE ACCESO - SENA VELEZ
# Copia este archivo a config/.env y rellena TODOS los valores.
# El sistema NO arranca si falta alguna variable obligatoria.
# =====================================================================

# --- OBLIGATORIAS ---

# Firma las cookies de sesion. Si alguien la conoce, puede suplantar al admin.
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cadena de conexion a PostgreSQL. Sin fallback: si falta, el sistema no arranca
# (antes caia silenciosamente a un SQLite efimero y se perdian los datos).
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos


# --- CORREO (SMTP) ---
# Necesario para codigos de verificacion y recuperacion de contrasena.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Con Gmail + 2FA hay que generar una "Contrasena de aplicacion",
# no sirve la contrasena normal de la cuenta.
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=


# --- SUPER ADMINISTRADOR ---
# ADMIN_PASSWORD solo se usa la PRIMERA vez, para crear la cuenta.
# Si el admin ya existe, este script no toca su contrasena.
# Minimo 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DOCUMENTO=999999999


# --- OPCIONALES ---

# Restringe el registro publico a estos dominios de correo, separados por coma.
# RECOMENDADO rellenarlo: vacio significa que cualquier persona de internet
# puede crear una cuenta en un sistema de control de acceso institucional.
DOMINIOS_REGISTRO=sena.edu.co,soy.sena.edu.co

# Poner en 'false' SOLO para desarrollo local sin HTTPS.
# En produccion debe quedar en 'true' para que las cookies lleven flag Secure.
COOKIES_SEGURAS=true

# Hilos de gunicorn. La concurrencia de este sistema sale de los HILOS, no de
# los procesos.
#
# NO se anade GUNICORN_WORKERS y docker/entrypoint.sh fija --workers 1 a mano
# a proposito: el planificador de tareas (APScheduler) vive DENTRO del proceso
# de la aplicacion. Con dos workers habria dos planificadores identicos: el
# cierre nocturno registraria salidas duplicadas y, peor, el respaldo mensual
# escribiria el mismo .xlsx desde dos procesos a la vez y despues borraria las
# filas de la base sobre un archivo ya corrupto.
# Si alguien "arregla" el entrypoint para leer una variable de workers, hay
# que sacar antes el planificador a su propio contenedor (poniendo
# EJECUTAR_TAREAS=false en los procesos web).
GUNICORN_THREADS=4

# Poner en 'false' si algun dia se separa el planificador de tareas a otro
# contenedor, para que este proceso no las ejecute tambien.
EJECUTAR_TAREAS=true

# --- LIMITE DE PETICIONES (rate limiting) ---

# Cuantos proxies propios hay delante de la aplicacion.
#   1 = produccion detras de Coolify/Traefik (valor correcto para el despliegue)
#   0 = la aplicacion se expone directa, tipico en desarrollo local
# IMPORTANTE: poner un numero MAYOR que el real es un agujero, no un ajuste:
# cualquiera podria mandar una cabecera X-Forwarded-For inventada, aparentar
# otra IP y saltarse todos los limites por IP.
PROXIES_CONFIABLES=1

# Donde se guardan los contadores.
#   memory://          -> en la memoria del proceso (valor por defecto)
#   redis://host:6379/0 -> compartido entre procesos
# Con 'memory://' los contadores SE PIERDEN en cada reinicio o redespliegue:
# quien estuviera bloqueado por pasarse de peticiones vuelve a empezar de cero.
# Es aceptable porque gunicorn corre con UN solo worker (ver
# docker/entrypoint.sh); si algun dia se levanta mas de un proceso, hay que
# pasar a Redis o cada worker contara por separado y el limite real sera el
# doble, el triple, etc.
RATELIMIT_STORAGE_URI=memory://

# Interruptor general del limite de peticiones. Ponerlo en 'false' apaga TODOS
# los limites de golpe: solo para depurar o si un limite mal calibrado
# estuviera bloqueando a gente real.
LIMITE_PETICIONES=true

# Techo general por usuario (o por IP si no hay sesion), aparte de los limites
# finos de cada endpoint que estan en app/utils/limitador.py. Es alto a
# proposito: no busca moderar el uso normal, solo cortar una inundacion.
LIMITE_GENERAL=120 per minute;2000 per hour


# --- DESAFIO ANTI-BOT (autoalojado, sin servicios externos) ---

# Protege el registro publico y la recuperacion de contrasena con una prueba
# de trabajo que resuelve el navegador. No habla con Cloudflare ni con Google:
# no sale ningun dato del aprendiz hacia terceros y no hay ningun servicio
# externo que pueda caerse y dejar a la gente sin poder registrarse.
# Ponerlo en 'false' lo apaga por completo y los formularios siguen igual.
CAPTCHA_ACTIVO=true

# Cuanto trabajo cuesta resolver el desafio. Mas alto = mas caro para un bot,
# pero tambien mas espera en un celular viejo. 60000 ronda la decima de
# segundo en un telefono de gama baja.
CAPTCHA_DIFICULTAD=60000


# Solo desarrollo: recarga las plantillas de Jinja al editarlas.
RECARGAR_PLANTILLAS=false


# --- GENERALIDADES INSTITUCIONALES (carnet, correos y pie de pagina) ---
# Si el sistema se instala en otro centro del SENA, basta cambiar estos valores:
# ninguno esta escrito dentro de las plantillas ni del codigo.
# Todos son opcionales; si faltan se usan los del centro de Velez.
CARNET_ENTIDAD=SENA
CARNET_ENTIDAD_LARGA=Servicio Nacional de Aprendizaje
CARNET_REGIONAL=Regional Santander
CARNET_CENTRO=Centro de Gestion Agroempresarial del Oriente
CARNET_MUNICIPIO=Velez

# Bloque de la poliza estudiantil, que solo se imprime en el carnet de aprendiz.
# Si CARNET_ASEGURADORA se deja vacia, el bloque no se pinta.
CARNET_ASEGURADORA=Aseguradora Aurora
CARNET_ASEGURADORA_TEL=601-7443718 Op. 1
CARNET_POLIZA=100603

# Traduccion de los cargos del sistema a los cinco perfiles del carnet impreso
# (APRENDIZ, INSTRUCTOR, CONTRATISTA, FUNCIONARIO, SUBDIRECTOR).
# Formato: Cargo:PERFIL separados por coma. Vacio = se usa el mapeo por defecto
# de app/utils/carnet.py. OJO: esto NO cambia permisos, solo lo que se imprime.
CARNET_PERFILES=

# --- MODO DE ENVIO DE CORREO ---
# 'rele'    (por defecto): la aplicacion le pide a un servidor de correo que
#           entregue el mensaje. Es lo fiable: usa el servidor de la institucion.
# 'directo': la propia aplicacion entrega al servidor del destinatario, sin
#           intermediarios. ANTES DE ACTIVARLO comprueba en el servidor que el
#           puerto 25 de SALIDA no este bloqueado:
#               python scripts/probar_correo.py --puerto-25
#           Casi todos los VPS lo bloquean por defecto. Y aunque este abierto,
#           sin SPF, DKIM, DMARC y DNS inverso los correos acaban en spam.
MAIL_MODO=rele

# Si la entrega directa falla, reintentar por el rele configurado arriba.
MAIL_RESPALDO_RELE=true

# Cifrado: se deduce del puerto (465=ssl, 587=starttls, 25=ninguno).
# Solo hace falta si tu servidor usa una combinacion distinta.
# MAIL_CIFRADO=starttls

# Nombre que ve el destinatario como remitente.
MAIL_NOMBRE_REMITENTE=Sistema de Acceso SENA

# Segundos de pausa entre correos consecutivos. Gmail gratuito permite unos
# 500 correos al dia; enviarlos en avalancha dispara su deteccion de abuso.
MAIL_PAUSA_SEGUNDOS=1.2
